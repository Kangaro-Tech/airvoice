# Example .env.example
# Copy this file to `.env` for local development or set these variables
# in Vercel (Project Settings → Environment Variables).

# API endpoints
VITE_API_BASE_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000

# Supabase
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Firebase (replace with your project's keys)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# External APIs / feature keys
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key

# Do NOT commit your real secrets. Use Vercel dashboard to set values.