# ── Dependencies ──────────────────────────────────────────────
node_modules/
.npm

# ── Build outputs ─────────────────────────────────────────────
dist/
build/

# ── Environment files (NEVER commit these!) ──────────────────
.env
.env.local
.env.production
.env.staging

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*

# ── Docker ────────────────────────────────────────────────────
# (docker-compose.yml IS committed, but not override files)
docker-compose.override.yml

# ── OS files ──────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────
.vscode/settings.json
.idea/

# ── TypeScript ────────────────────────────────────────────────
*.tsbuildinfo

# ── Vite cache ────────────────────────────────────────────────
.vite/
vite.config.ts.timestamp-*

# ── Excel / uploads ───────────────────────────────────────────
*.xlsx
*.csv
uploads/
tmp/
