# ── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co

SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Firebase ────────────────────────────────────────────────
# Paste minified JSON of your Firebase service account key
# Leave empty to run in dev mode (token verification skipped)
FIREBASE_SERVICE_ACCOUNT_KEY=

FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# ── API ─────────────────────────────────────────────────────
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# ── Rate limiting ────────────────────────────────────────────
OTP_RATE_LIMIT_WINDOW_MS=600000
OTP_RATE_LIMIT_MAX=3

# ── Signed URL expiry (seconds) ──────────────────────────────
SIGNED_URL_EXPIRY_SECONDS=900

# ── Anthropic Claude API ──────────────────────────────────────
# Paste your actual Claude API key here (e.g. sk-ant-...)
CLAUDE_API_KEY=your_claude_api_key_here

# ── Google Cloud Translation API ──────────────────────────────
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here
