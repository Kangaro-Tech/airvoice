# ============================================================
# AirVoice - Root .env for docker-compose
# Copy this file to .env and fill in your actual values
# ⚠️  NEVER commit .env to git!
# ============================================================

# ── Frontend Build Args (VITE_ prefix required) ─────────────
# Your domain - change this to your actual domain
VITE_API_BASE_URL=https://YOUR_DOMAIN.com/api
VITE_API_URL=https://YOUR_DOMAIN.com/api

# Supabase
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Firebase
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Google APIs
VITE_GEMINI_API_KEY=your_gemini_api_key
VITE_GOOGLE_TRANSLATE_API_KEY=your_google_translate_key
